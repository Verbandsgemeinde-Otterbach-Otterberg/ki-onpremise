# Konfiguration des LLM-Stacks (Ollama + Auth-Proxy + Open WebUI + Nginx)
# Wird von install.sh nach /etc/llm-stack/llm-stack.env kopiert.
# Keine Kommentare hinter Werten schreiben (die Datei wird auch von systemd gelesen).

# --- Pflichtangaben -------------------------------------------------------
# Domain, unter der Open WebUI erreichbar sein soll (DNS-A-Eintrag muss auf den Server zeigen)
DOMAIN=
# E-Mail-Adresse für Let's Encrypt
LETSENCRYPT_EMAIL=

# --- Geheimnisse (leer lassen = werden bei der Installation erzeugt) ------
PROXY_TOKEN=
WEBUI_SECRET_KEY=

# --- Modelle --------------------------------------------------------------
# Chat-Modelle, die bei der Installation geladen werden
CHAT_MODELS="gemma4:26b-a4b-it-qat llama3.2:3b"
# Modell, das nach der Installation freigegeben ist
DEFAULT_MODEL=gemma4:26b-a4b-it-qat
# Embedding-Modell für die Wissensdatenbank (immer freigegeben)
EMBED_MODEL=nomic-embed-text
# Kontextlänge in Token und Verweildauer eines Modells im Grafikspeicher
CONTEXT_LENGTH=16384
KEEP_ALIVE=10m

# --- Open WebUI -----------------------------------------------------------
WEBUI_NAME=OtterMind
# Für reproduzierbare Installationen eine feste Version eintragen, z. B. :v0.11.3
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
OPENWEBUI_PORT=3000

# --- Netzwerk -------------------------------------------------------------
DOCKER_NETWORK=llm-net
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1
# Feste Adresse des Open-WebUI-Containers; nur diese darf den Proxy ohne Token nutzen
WEBUI_CONTAINER_IP=172.30.0.10
PROXY_PORT=11435
# Adressen, an die der Proxy bindet (Tailscale-Adresse wird bei Bedarf automatisch ergänzt)
PROXY_BIND=172.30.0.1

# --- Optional: API-Zugriff über Tailscale-VPN -----------------------------
TAILSCALE_ENABLED=no
# Optionaler Auth-Key für die unbeaufsichtigte Anmeldung
TAILSCALE_AUTHKEY=
